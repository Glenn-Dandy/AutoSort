<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
    <id>autosort</id>
    <name>AutoSort</name>
    <summary>Sort PDFs into folders based on their content</summary>
    <description><![CDATA[AutoSort moves and renames PDFs from an inbox folder based on the text inside them. Every user defines their own rules in the personal settings: the words a document has to contain, the target folder and the new file name.

Requires pdftotext on the server (poppler-utils) and PDFs with a text layer.]]></description>
    <version>0.8.1</version>
    <licence>AGPL-3.0-or-later</licence>
    <author>Glenn-Dandy</author>
    <namespace>AutoSort</namespace>
    <documentation>
        <user>https://github.com/Glenn-Dandy/AutoSort#readme</user>
        <admin>https://github.com/Glenn-Dandy/AutoSort#readme</admin>
    </documentation>
    <category>files</category>
    <category>workflow</category>
    <website>https://github.com/Glenn-Dandy/AutoSort</website>
    <bugs>https://github.com/Glenn-Dandy/AutoSort/issues</bugs>
    <repository type="git">https://github.com/Glenn-Dandy/AutoSort.git</repository>
    <screenshot>https://raw.githubusercontent.com/Glenn-Dandy/AutoSort/main/screenshots/settings.jpg</screenshot>
    <dependencies>
        <nextcloud min-version="33" max-version="36"/>
    </dependencies>
    <settings>
        <personal>OCA\AutoSort\Settings\Personal</personal>
        <personal-section>OCA\AutoSort\Settings\PersonalSection</personal-section>
    </settings>
</info>
